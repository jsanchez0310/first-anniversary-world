---
import Layout from '../layouts/Layout.astro';
import IntroHero from '../components/IntroHero.astro';
import NavigationIsland from '../components/NavigationIsland.astro';
import TextReveal from '../components/TextReveal.astro';
import { STORY_SECTIONS } from '../config/story';
---

<Layout title="Primer Aniversario — Un Universo a Dos Voces">
  <!-- Boton discreto de control de audio en la esquina superior -->
  <NavigationIsland />

  <main class="relative bg-[#000000] text-zinc-100 overflow-x-hidden">
    <!-- Escenario de Video Continuo (Fijo en pantalla completa) -->
    <div id="cinema-stage-mount" class="fixed inset-0 w-full h-full overflow-hidden pointer-events-none z-0 bg-[#000000]">
      <!-- Video 1: Loop de bienvenida (El Libro Mágico) con sonido activado -->
      <video
        id="video-initial-loop"
        src="/initial_loop_video.mp4"
        autoplay
        loop
        playsinline
        preload="auto"
        class="absolute inset-0 w-full h-full object-cover transition-opacity duration-1000 ease-in-out opacity-100 z-10"
      ></video>

      <!-- Video 2: Transición cinemática on_intro_start con sonido activado -->
      <video
        id="video-intro-start"
        src="/on_intro_start.mp4"
        playsinline
        preload="auto"
        class="absolute inset-0 w-full h-full object-cover transition-opacity duration-1000 ease-in-out opacity-0 z-0"
      ></video>

      <!-- Contenedor dinámico de clips de los mundos gobernado por ScrollWorldEngine -->
      <div id="sw-world-clips" class="absolute inset-0 w-full h-full opacity-0 transition-opacity duration-1000 ease-in-out z-0"></div>
    </div>

    <!-- Hero de bienvenida limpio sin texto encima del libro -->
    <IntroHero />

    <!-- Pista de Scrollytelling de los Mundos (Controla la altura y progreso del scroll) -->
    <div 
      id="scroll-story-track" 
      class="relative z-10 w-full pointer-events-none hidden" 
      style="height: 800vh;"
    ></div>

    <!-- Escenario Narrativo Fijo en Pantalla Completa (Configurable por mundo: left [30%], right [30%] o bottom; Acto siempre arriba a la izquierda) -->
    <div 
      id="cinema-bottom-overlay" 
      class="fixed inset-0 z-20 pointer-events-none transition-opacity duration-700 opacity-0 overflow-hidden"
    >
      {STORY_SECTIONS.map((sec, idx) => {
        const align = sec.alignment || 'left';
        return (
          <div 
            id={`narrative-world-${idx}`}
            class="narrative-world-panel fixed inset-0 px-6 sm:px-12 md:px-16 pt-6 sm:pt-8 pb-8 sm:pb-12 flex flex-col justify-between transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] opacity-0 translate-y-6 pointer-events-none select-none"
            data-world-index={idx}
            data-audio={sec.audioTrack}
          >
            <!-- Fondos de gradiente cinematográfico (solo en el texto de abajo y en diagonal) -->
            {align === 'left' && (
              <div class="absolute bottom-0 left-0 w-full sm:w-[70%] md:w-[50%] lg:w-[40%] h-[55vh] max-h-[460px] bg-gradient-to-tr from-black/95 via-black/50 to-transparent pointer-events-none -z-10"></div>
            )}
            {align === 'right' && (
              <div class="absolute bottom-0 right-0 w-full sm:w-[70%] md:w-[50%] lg:w-[40%] h-[55vh] max-h-[460px] bg-gradient-to-tl from-black/95 via-black/50 to-transparent pointer-events-none -z-10"></div>
            )}
            {align === 'bottom' && (
              <div class="absolute inset-x-0 bottom-0 h-56 sm:h-64 bg-gradient-to-t from-black/95 via-black/60 to-transparent pointer-events-none -z-10"></div>
            )}

            <!-- TOP: Línea de Acto (SIEMPRE ARRIBA A LA IZQUIERDA, SIN PILL, TAL CUAL ESTABA) -->
            <div class="relative z-10 self-start max-w-[calc(100%-190px)]">
              <span 
                class="text-xs uppercase tracking-wider font-semibold flex items-center gap-1.5 drop-shadow-[0_2px_8px_rgba(0,0,0,0.95)]"
                style={`color: ${sec.accent};`}
              >
                <span class="inline-block w-1.5 h-1.5 rounded-full" style={`background-color: ${sec.accent};`}></span>
                {sec.actTitle}: {sec.actSubtitle}
              </span>
            </div>

            <!-- BOTTOM: Título del Mundo y Revelado de Narrativa -->
            <div class={`relative z-10 flex flex-col items-start text-left pb-2 sm:pb-4 ${
              align === 'left' 
                ? 'w-full sm:w-[85%] md:w-[35%] lg:w-[30%] max-w-xl self-start' 
                : align === 'right'
                ? 'w-full sm:w-[85%] md:w-[35%] lg:w-[30%] max-w-xl self-end ml-auto'
                : 'w-full max-w-5xl mx-auto self-center'
            }`}>
              <!-- Título del Mundo -->
              <h2 class={`font-bold tracking-tight text-[#f4f4f5] mb-2 sm:mb-3 text-balance drop-shadow-[0_2px_14px_rgba(0,0,0,0.95)] ${
                align === 'bottom'
                  ? 'text-2xl sm:text-3xl md:text-4xl'
                  : 'text-2xl sm:text-3xl md:text-[1.85rem] lg:text-[2.1rem] leading-tight'
              }`}>
                {sec.title}
              </h2>

              <!-- Revelado Typewriter de la Narrativa con TypeIt -->
              <TextReveal quote={sec.quote} worldIndex={idx} alignment={align} />

              {sec.clips.length === 0 && (
                <p class="mt-2 text-xs font-mono text-amber-300/80 italic flex items-center gap-1.5">
                  <span>✦</span>
                  <span>Paisaje en creacion: nuevos clips conectaran este horizonte al agregarse en /public.</span>
                </p>
              )}
            </div>
          </div>
        );
      })}
    </div>

    <!-- Sección de Cierre / Epílogo -->
    <section 
      id="epilogue-section"
      class="relative min-h-[90vh] flex flex-col items-center justify-center px-6 py-24 bg-transparent text-center z-10 pointer-events-auto hidden"
    >
      <div class="max-w-2xl flex flex-col items-center p-8 sm:p-12 rounded-3xl bg-black/40 backdrop-blur-md border border-white/10 shadow-2xl">
        <span class="text-xs font-mono uppercase tracking-widest text-[#d4af37] mb-4">Epilogo y Promesa</span>
        <h3 class="text-3xl sm:text-5xl font-bold tracking-tight text-[#f4f4f5] mb-6 text-balance max-w-[680px]">
          "Lo esencial es invisible a los ojos"
        </h3>
        <p class="text-zinc-300 leading-relaxed text-pretty mb-8 text-base sm:text-lg">
          Gracias por este primer ano recorriendo mundos, aprendiendo a volar entre tormentas y creando juntos nuestro propio hogar cosmico.
        </p>
        <button 
          id="btn-return-top"
          class="px-8 py-3 rounded-full border border-amber-400/40 bg-zinc-900/80 hover:bg-zinc-800 text-base font-semibold text-zinc-100 transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] hover:scale-[1.03] active:scale-[0.98] cursor-pointer shadow-lg"
        >
          Volver al Inicio
        </button>
      </div>
    </section>
  </main>
</Layout>

<script>
  import { ScrollWorldEngine } from '../utils/ScrollWorldEngine';
  import { AudioController } from '../utils/AudioController';
  import { AutoScrollController } from '../utils/AutoScrollController';
  import { STORY_SECTIONS } from '../config/story';

  const audio = AudioController.getInstance();
  const autoscroll = AutoScrollController.getInstance();
  const videoLoop = document.getElementById('video-initial-loop') as HTMLVideoElement | null;
  const videoIntroStart = document.getElementById('video-intro-start') as HTMLVideoElement | null;
  const worldClipsContainer = document.getElementById('sw-world-clips') as HTMLElement | null;
  const heroOverlay = document.getElementById('intro-hero-overlay') as HTMLElement | null;
  const startBtn = document.getElementById('btn-start-journey') as HTMLButtonElement | null;
  const returnTopBtn = document.getElementById('btn-return-top') as HTMLButtonElement | null;
  const storyTrack = document.getElementById('scroll-story-track') as HTMLElement | null;
  const epilogue = document.getElementById('epilogue-section') as HTMLElement | null;
  const cinemaBottomOverlay = document.getElementById('cinema-bottom-overlay') as HTMLElement | null;

  let isIntroTransitionActive = false;
  let worldEngine: ScrollWorldEngine | null = null;
  let currentActiveWorldIndex = 0;

  // 1. Bloquear el scroll inicialmente para que solo se vea el video loop del libro
  document.body.style.overflow = 'hidden';
  window.scrollTo(0, 0);

  // Registrar videos con el controlador de audio para sincronización
  if (videoLoop) {
    audio.registerVideo(videoLoop);
    // Intentar reproducir con sonido; si la política del navegador lo bloquea, reproducir silenciado temporalmente hasta el primer gesto
    videoLoop.play().catch(() => {
      videoLoop.muted = true;
      videoLoop.play().catch(() => {});
    });
  }
  if (videoIntroStart) {
    audio.registerVideo(videoIntroStart);
  }

  // Desmutear videoLoop en el primer toque/clic si el navegador exigía interacción previa
  const unmuteOnFirstGesture = () => {
    audio.unlock();
    if (videoLoop && !audio.getIsMuted()) {
      videoLoop.muted = false;
    }
    window.removeEventListener('click', unmuteOnFirstGesture);
    window.removeEventListener('touchstart', unmuteOnFirstGesture);
  };
  window.addEventListener('click', unmuteOnFirstGesture, { once: true, passive: true });
  window.addEventListener('touchstart', unmuteOnFirstGesture, { once: true, passive: true });

  // Distribución de tramos para cada mundo en la pista de scroll (0 a 1)
  const worldSpans = [
    { worldIndex: 0, start: 0.00, end: 0.36 },
    { worldIndex: 1, start: 0.36, end: 0.52 },
    { worldIndex: 2, start: 0.52, end: 0.68 },
    { worldIndex: 3, start: 0.68, end: 0.84 },
    { worldIndex: 4, start: 0.84, end: 1.00 },
  ];

  // Actualizar el efecto typewriter en sincronía bidireccional continua con el scroll (adelante y atrás)
  function updateTypewriterProgress(worldIdx: number, worldProgress: number) {
    const target = document.getElementById(`typeit-quote-${worldIdx}`);
    if (!target) return;

    const fullQuote = target.getAttribute('data-quote') || STORY_SECTIONS[worldIdx]?.quote || '';
    const textSpan = target.querySelector('.ti-text') as HTMLElement | null;
    if (!textSpan) return;

    // Rango de tipeo dentro del mundo: desde el 4% hasta el 82% del avance del mundo
    // Al superar el 82% queda 100% tipeado para que el lector lo disfrute completo antes de cambiar de mundo
    const ratio = Math.min(1, Math.max(0, (worldProgress - 0.04) / 0.78));
    const targetLength = Math.round(ratio * fullQuote.length);

    // Escribir hacia adelante o retrasar/borrar hacia atrás según la posición exacta del scroll
    const currentLength = textSpan.textContent?.length || 0;
    if (currentLength !== targetLength) {
      textSpan.textContent = fullQuote.slice(0, targetLength);
    }
  }

  function resetAllTypewriters() {
    STORY_SECTIONS.forEach((_, idx) => {
      const target = document.getElementById(`typeit-quote-${idx}`);
      const textSpan = target?.querySelector('.ti-text') as HTMLElement | null;
      if (textSpan) textSpan.textContent = '';
    });
  }

  // Actualizar qué mundo se muestra en la parte baja de la pantalla
  function updateActiveWorld(worldIdx: number) {
    currentActiveWorldIndex = worldIdx;

    // Cambiar audio ambiental suavemente
    const targetSection = STORY_SECTIONS[worldIdx];
    if (targetSection && targetSection.audioTrack) {
      audio.playTrack(targetSection.audioTrack, 1600);
    }

    // Actualizar paneles de texto en la parte baja de la pantalla
    const panels = document.querySelectorAll('.narrative-world-panel');
    panels.forEach((panel) => {
      const idx = Number(panel.getAttribute('data-world-index'));
      const el = panel as HTMLElement;
      const targetQuote = document.getElementById(`typeit-quote-${idx}`);
      const textSpan = targetQuote?.querySelector('.ti-text') as HTMLElement | null;
      const quoteText = targetQuote?.getAttribute('data-quote') || STORY_SECTIONS[idx]?.quote || '';

      if (idx === worldIdx) {
        el.style.opacity = '1';
        el.style.transform = 'translateY(0)';
        el.style.pointerEvents = 'auto';
      } else if (idx < worldIdx) {
        el.style.opacity = '0';
        el.style.transform = 'translateY(-16px)';
        el.style.pointerEvents = 'none';
        // Si el usuario ya pasó este mundo hacia adelante, mantener el texto completo
        if (textSpan && textSpan.textContent?.length !== quoteText.length) {
          textSpan.textContent = quoteText;
        }
      } else {
        el.style.opacity = '0';
        el.style.transform = 'translateY(16px)';
        el.style.pointerEvents = 'none';
        // Si es un mundo futuro que aún no se alcanza, mantener vacío
        if (textSpan) textSpan.textContent = '';
      }
    });
  }

  // Manejar el progreso continuo del scroll: sincronización bidireccional del texto y overlay
  function handleProgress(rawProgress: number, activeWorldIdx: number, worldProgress: number) {
    if (cinemaBottomOverlay && isIntroTransitionActive) {
      if (rawProgress >= 0.98) {
        cinemaBottomOverlay.style.opacity = '0';
        cinemaBottomOverlay.style.pointerEvents = 'none';
      } else {
        cinemaBottomOverlay.style.opacity = '1';
        cinemaBottomOverlay.style.pointerEvents = 'auto';
      }
    }

    // Sincronizar tipeo y borrado de caracteres según el scroll exacto (adelante y atrás)
    if (isIntroTransitionActive) {
      updateTypewriterProgress(activeWorldIdx, worldProgress);
    }
  }

  // Inicializar clips para el scrub engine (pre-carga en memoria Blobs)
  if (worldClipsContainer && storyTrack) {
    const clipItems: Array<{ id: string; url: string; urlMobile?: string; linger?: number; start?: number; end?: number }> = [];
    const w1Clips = STORY_SECTIONS[0].clips;
    const clipSlice = 0.36 / (w1Clips.length || 1);

    w1Clips.forEach((clipUrl, cIdx) => {
      clipItems.push({
        id: `world-1-clip-${cIdx}`,
        url: clipUrl,
        urlMobile: STORY_SECTIONS[0].clipMobile,
        linger: STORY_SECTIONS[0].linger ?? 0.45,
        start: cIdx * clipSlice,
        end: (cIdx + 1) * clipSlice,
      });
    });

    worldEngine = new ScrollWorldEngine({
      container: worldClipsContainer,
      trackElement: storyTrack,
      clips: clipItems,
      worldSpans: worldSpans,
      onWorldChange: (worldIdx) => {
        updateActiveWorld(worldIdx);
      },
      onProgress: (rawProgress, _clipIdx, activeWorldIdx, worldProgress) => {
        handleProgress(rawProgress, activeWorldIdx, worldProgress);
      }
    });
  }

  // Interacción del Hero: Comenzar -> on_intro_start.mp4 -> Desbloquea Scroll-World
  if (startBtn && videoIntroStart && videoLoop && worldClipsContainer && storyTrack) {
    startBtn.addEventListener('click', async () => {
      if (isIntroTransitionActive) return;
      isIntroTransitionActive = true;

      // Desbloquear audio globalmente
      audio.unlock();

      // Asegurar que on_intro_start esté desmuteado según el estado de audio
      videoIntroStart.muted = audio.getIsMuted();

      // Ocultar botón del hero
      if (heroOverlay) {
        heroOverlay.style.opacity = '0';
        heroOverlay.style.pointerEvents = 'none';
        setTimeout(() => { heroOverlay.style.display = 'none'; }, 700);
      }

      // Traer al frente y reproducir el video de transición on_intro_start
      videoIntroStart.style.zIndex = '15';
      videoIntroStart.style.opacity = '1';
      videoIntroStart.volume = 1;
      videoIntroStart.currentTime = 0;

      try {
        await videoIntroStart.play();
      } catch (_e) {
        // En caso extremo de bloqueo
        videoIntroStart.muted = true;
        await videoIntroStart.play().catch(() => {});
      }

      // Desvanecer video loop inicial tras arrancar
      setTimeout(() => {
        videoLoop.style.opacity = '0';
        videoLoop.pause();
      }, 400);

      // Fade out suave del audio del video introductorio en sus ultimos segundos
      let isAudioFadingOut = false;
      const audioFadeDurationSec = 1.2; // 1200ms de fade out antes de terminar
      const onTimeUpdate = () => {
        if (!videoIntroStart.duration || isAudioFadingOut) return;
        const timeLeft = videoIntroStart.duration - videoIntroStart.currentTime;
        if (timeLeft <= audioFadeDurationSec && timeLeft > 0) {
          isAudioFadingOut = true;
          // Iniciar fade out progresivo del volumen
          const startVol = videoIntroStart.volume;
          const fadeStartTime = performance.now();
          const fadeMs = timeLeft * 1000;

          const stepFade = (now: number) => {
            const elapsed = now - fadeStartTime;
            const progress = Math.min(1, elapsed / fadeMs);
            videoIntroStart.volume = Math.max(0, startVol * (1 - progress));
            if (progress < 1 && !videoIntroStart.paused) {
              requestAnimationFrame(stepFade);
            }
          };
          requestAnimationFrame(stepFade);
        }
      };
      videoIntroStart.addEventListener('timeupdate', onTimeUpdate);

      // Cuando termine el video de transición, transición suave hacia los mundos
      videoIntroStart.onended = () => {
        videoIntroStart.removeEventListener('timeupdate', onTimeUpdate);

        // 1. Mostrar los clips del mundo y activar primer mundo
        worldClipsContainer.style.zIndex = '20';
        worldClipsContainer.style.opacity = '1';
        updateActiveWorld(0);

        // 2. Iniciar música ambiental de fondo del acto 1 con crossfade cinematográfico
        audio.playTrack('/audio/act_1.mp3', 2000);

        // 3. Desvanecer el video de intro suavemente con su transición CSS de 1000ms
        videoIntroStart.style.opacity = '0';

        // 4. Habilitar la pista de scroll, el overlay narrativo inferior y el epílogo
        storyTrack.classList.remove('hidden');
        if (cinemaBottomOverlay) {
          cinemaBottomOverlay.style.opacity = '1';
        }
        if (epilogue) epilogue.classList.remove('hidden');

        // Desbloquear el scroll del documento
        document.body.style.overflow = '';
        document.documentElement.style.overflow = '';

        // Actualizar dimensiones en el motor de scroll
        worldEngine?.update();

        // Tras concluir el fundido visual (1000ms), enviar intro al fondo y pausar
        setTimeout(() => {
          videoIntroStart.style.zIndex = '0';
          videoIntroStart.pause();
          videoIntroStart.volume = 1;
        }, 1000);

        // Iniciar el auto-scroll poético con un respiro natural tras abrirse el mundo
        setTimeout(() => {
          worldEngine?.update();
          autoscroll.startJourney();
        }, 1200);
      };
    });
  }

  // Listener de scroll para el motor
  window.addEventListener('scroll', () => {
    worldEngine?.update();
  }, { passive: true });

  // Botón volver al inicio: resetear completamente la experiencia
  if (returnTopBtn) {
    returnTopBtn.addEventListener('click', () => {
      // 1. Llevar scroll de inmediato al tope
      window.scrollTo({ top: 0, behavior: 'instant' });

      // 2. Bloquear nuevamente el scroll
      document.body.style.overflow = 'hidden';
      document.documentElement.style.overflow = 'hidden';

      // 3. Ocultar la pista de historias, el overlay narrativo inferior y el epílogo
      if (storyTrack) storyTrack.classList.add('hidden');
      if (cinemaBottomOverlay) cinemaBottomOverlay.style.opacity = '0';
      if (epilogue) epilogue.classList.add('hidden');

      // Detener y resetear auto-scroll
      autoscroll.stop();

      // 4. Ocultar clips del mundo
      if (worldClipsContainer) {
        worldClipsContainer.style.opacity = '0';
        worldClipsContainer.style.zIndex = '0';
      }

      // 5. Restablecer y pausar video on_intro_start
      if (videoIntroStart) {
        videoIntroStart.pause();
        videoIntroStart.currentTime = 0;
        videoIntroStart.style.opacity = '0';
        videoIntroStart.style.zIndex = '0';
      }

      // 6. Volver a mostrar y reproducir el loop inicial del libro
      if (videoLoop) {
        videoLoop.currentTime = 0;
        videoLoop.style.opacity = '1';
        videoLoop.style.zIndex = '10';
        videoLoop.play().catch(() => {});
      }

      // 7. Mostrar nuevamente el botón del hero
      if (heroOverlay) {
        heroOverlay.style.display = 'flex';
        heroOverlay.style.pointerEvents = 'auto';
        requestAnimationFrame(() => {
          heroOverlay.style.opacity = '1';
        });
      }

      // 8. Resetear flags de estado y typewriter TypeIt
      isIntroTransitionActive = false;
      resetAllTypewriters();
      updateActiveWorld(0);
    });
  }
</script>
