---
import Layout from '../layouts/Layout.astro';
import IntroHero from '../components/IntroHero.astro';
import NavigationIsland from '../components/NavigationIsland.astro';
import TextReveal from '../components/TextReveal.astro';
import LoadingScreen from '../components/LoadingScreen.astro';
import { STORY_SECTIONS, INTRO_MEDIA } from '../config/story';
---

<Layout title="Primer Aniversario — Un Universo a Dos Voces">
  <!-- Pantalla de Carga Inicial con Barra de Progreso Real -->
  <LoadingScreen />

  <!-- Boton discreto de control de audio en la esquina superior -->
  <NavigationIsland />

  <main class="relative bg-[#000000] text-zinc-100 overflow-x-hidden">
    <!-- Escenario de Video Continuo (Fijo en pantalla completa) -->
    <div id="cinema-stage-mount" class="fixed inset-0 w-full h-full overflow-hidden pointer-events-none z-0 bg-[#000000]">
      <!-- Video 1: Loop de bienvenida (El Libro Mágico) con sonido activado -->
      <video
        id="video-initial-loop"
        loop
        playsinline
        preload="none"
        class="absolute inset-0 w-full h-full object-cover transition-opacity duration-1000 ease-in-out opacity-100 z-10"
      ></video>

      <!-- Video 2: Transición cinemática on_intro_start con sonido activado -->
      <video
        id="video-intro-start"
        playsinline
        preload="none"
        class="absolute inset-0 w-full h-full object-cover transition-opacity duration-1000 ease-in-out opacity-0 z-0"
      ></video>

      <!-- Contenedor dinámico de clips de los mundos gobernado por ScrollWorldEngine -->
      <div id="sw-world-clips" class="absolute inset-0 w-full h-full opacity-0 transition-opacity duration-1000 ease-in-out z-0"></div>
    </div>

    <!-- Hero de bienvenida limpio sin texto encima del libro -->
    <IntroHero />

    <!-- Pista de Scrollytelling de los Mundos (Controla la altura y progreso del scroll) -->
    <div 
      id="scroll-story-track" 
      class="relative z-10 w-full pointer-events-none hidden" 
      style="height: 1200vh;"
    ></div>

    <!-- Escenario Narrativo Fijo en Pantalla Completa (Configurable por mundo: left [30%], right [30%] o bottom; Acto siempre arriba a la izquierda) -->
    <div 
      id="cinema-bottom-overlay" 
      class="fixed inset-0 z-20 pointer-events-none transition-opacity duration-700 opacity-0 overflow-hidden"
    >
      {STORY_SECTIONS.map((sec, idx) => {
        const align = sec.alignment || 'left';
        return (
          <div 
            id={`narrative-world-${idx}`}
            class="narrative-world-panel fixed inset-0 px-6 xl:px-8 pt-3 xl:pt-12 pb-3 xl:pb-12 flex flex-col justify-between transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] opacity-0 translate-y-6 pointer-events-none select-none"
            data-world-index={idx}
            data-audio={sec.audioTrack}
          >
            <!-- Fondos de gradiente cinematográfico (solo en el texto de abajo y en diagonal) -->
            {align === 'left' && (
              <div class="absolute bottom-0 left-0 w-full sm:w-[70%] md:w-[50%] lg:w-[40%] h-[55vh] max-h-[460px]  pointer-events-none -z-10"></div>
            )}
            {align === 'right' && (
              <div class="absolute bottom-0 right-0 w-full sm:w-[70%] md:w-[50%] lg:w-[40%] h-[55vh] max-h-[460px] pointer-events-none -z-10"></div>
            )}
            {align === 'bottom' && (
              <div class="absolute inset-x-0 bottom-0 h-56 sm:h-64 pointer-events-none -z-10"></div>
            )}

            <!-- TOP: Línea de Acto (SIEMPRE ARRIBA A LA IZQUIERDA, SIN PILL, TAL CUAL ESTABA) -->
            <div class="relative z-50 self-start max-w-[calc(100%-190px)]">
              <span 
                class="text-xs uppercase tracking-wider font-semibold flex items-center gap-1.5 drop-shadow-[0_2px_8px_rgba(0,0,0,0.95)]"
                style={`color: ${sec.accent};`}
              >
                <span class="inline-block w-1.5 h-1.5 rounded-full" style={`background-color: ${sec.accent};`}></span>
                {sec.actTitle}: {sec.actSubtitle}
              </span>
            </div>

            <!-- BOTTOM: Título del Mundo y Revelado de Narrativa -->
            <div class={`relative z-10 flex flex-col items-start text-left pb-2 sm:pb-4 ${
              align === 'left' 
                ? 'w-full sm:w-[85%] md:w-[35%] lg:w-[30%] max-w-xl self-start max-sm:pb-16' 
                : align === 'right'
                ? 'w-full sm:w-[85%] md:w-[35%] lg:w-[30%] max-w-xl self-end ml-auto max-sm:pb-16'
                : 'w-full max-w-5xl mx-auto self-center'
            }`}>
              <!-- Título del Mundo -->
              <h2 class={`font-bold tracking-tight text-[#f4f4f5] mb-2 sm:mb-3 text-balance leading-tight drop-shadow-[0_2px_14px_rgba(0,0,0,0.95)] text-lg sm:text-xl md:text-2xl lg:text-3xl ${
                align === 'bottom'
                  ? 'text-center'
                  : align === 'right'
                  ? 'text-right'
                  : 'text-left'
              }`}>
                {sec.title}
              </h2>

              <!-- Revelado Typewriter de la Narrativa con TypeIt -->
              <TextReveal quote={sec.quote} worldIndex={idx} alignment={align} />

              {sec.clips.length === 0 && (
                <p class="mt-2 text-xs font-mono text-amber-300/80 italic flex items-center gap-1.5">
                  <span>✦</span>
                  <span>Paisaje en creacion: nuevos clips conectaran este horizonte al agregarse en /public.</span>
                </p>
              )}

              {/* Botón dentro debajo del texto cuando alignment === 'bottom' (solo en mundos con siguiente mundo) */}
              {idx < STORY_SECTIONS.length - 1 && align === 'bottom' && (
                <div class="mt-3.5 sm:mt-5 w-full flex items-center">
                  <button
                    id={`btn-next-world-${idx}`}
                    class="btn-next-world relative overflow-hidden group inline-flex items-center gap-2.5 px-5 py-2.5 rounded-full bg-black/75 hover:bg-[#1f1b13] border border-[#d4af37]/60 hover:border-[#d4af37] text-amber-100 hover:text-white font-mono text-xs tracking-wider uppercase backdrop-blur-md transition-all duration-500 hover:scale-[1.03] active:scale-[0.98] cursor-pointer shadow-[0_4px_24px_rgba(212,175,55,0.25)] opacity-0 pointer-events-none translate-y-3"
                    data-world-index={idx}
                    data-ready="false"
                    aria-label={`Avanzar al siguiente mundo`}
                  >
                    <span class="btn-progress-fill absolute inset-0 bg-gradient-to-r from-amber-600/35 via-amber-400/35 to-amber-200/35 transition-all duration-300 ease-out pointer-events-none" style="width: 0%;"></span>
                    <span class="relative z-10 flex items-center gap-2.5">
                      <span class="btn-status-dot w-2 h-2 rounded-full bg-[#d4af37] animate-ping"></span>
                      <span class="btn-label-text">Siguiente Mundo</span>
                      <svg class="w-3.5 h-3.5 text-[#d4af37] transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                      </svg>
                    </span>
                  </button>
                </div>
              )}
            </div>

            {/* Botón al extremo opuesto de la pantalla cuando alignment !== 'bottom' (left -> abajo a la derecha, right -> abajo a la izquierda) */}
            {idx < STORY_SECTIONS.length - 1 && align !== 'bottom' && (
              <div class={`absolute bottom-8 sm:bottom-12 z-20 pointer-events-none ${
                align === 'left' 
                  ? 'right-6 sm:right-12 md:right-16' 
                  : 'left-6 sm:left-12 md:left-16'
              }`}>
                <button
                  id={`btn-next-world-${idx}`}
                  class="btn-next-world relative overflow-hidden group inline-flex items-center gap-2.5 px-5 py-2.5 rounded-full bg-black/75 hover:bg-[#1f1b13] border border-[#d4af37]/60 hover:border-[#d4af37] text-amber-100 hover:text-white font-mono text-xs tracking-wider uppercase backdrop-blur-md transition-all duration-500 hover:scale-[1.03] active:scale-[0.98] cursor-pointer shadow-[0_4px_24px_rgba(212,175,55,0.25)] opacity-0 pointer-events-none translate-y-3"
                  data-world-index={idx}
                  data-ready="false"
                  aria-label={`Avanzar al siguiente mundo`}
                >
                  <span class="btn-progress-fill absolute inset-0 bg-gradient-to-r from-amber-600/35 via-amber-400/35 to-amber-200/35 transition-all duration-300 ease-out pointer-events-none" style="width: 0%;"></span>
                  <span class="relative z-10 flex items-center gap-2.5">
                    <span class="btn-status-dot w-2 h-2 rounded-full bg-[#d4af37] animate-ping"></span>
                    <span class="btn-label-text">Siguiente Mundo</span>
                    <svg class="w-3.5 h-3.5 text-[#d4af37] transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                    </svg>
                  </span>
                </button>
              </div>
            )}
          </div>
        );
      })}
    </div>

    <!-- Canvas de Confetti / Fuegos Artificiales (por detrás del card del epílogo) -->
    <canvas 
      id="epilogue-confetti-canvas" 
      class="fixed inset-0 w-full h-full pointer-events-none z-[15] transition-opacity duration-500 opacity-0"
    ></canvas>

    <!-- Sección de Cierre / Epílogo -->
    <section 
      id="epilogue-section"
      class="relative min-h-[90vh] flex flex-col items-center justify-center px-6 pt-16 pb-2 xl:pb-24 xl:pt-24 bg-transparent text-center z-20 pointer-events-auto hidden"
    >
      <div 
        id="epilogue-card"
        class="relative z-10 max-w-2xl flex flex-col items-center p-8 sm:p-12 rounded-3xl bg-black/60 backdrop-blur-md border border-white/10 shadow-2xl"
      >
        <span class="text-xs font-mono uppercase tracking-widest text-[#d4af37] mb-4">Feliz Aniversario</span>
        <h3 class="text-3xl sm:text-5xl font-bold tracking-tight text-[#f4f4f5] mb-6 text-balance max-w-[680px]">
          "Lo esencial es invisible a los ojos"
        </h3>
        <p class="text-zinc-300 leading-relaxed text-pretty mb-8 text-base sm:text-lg">
          Gracias por este primer año recorriendo mundos, aprendiendo a volar entre tormentas y creando juntos nuestra propia historia.
        </p>
        <p class='text-red-400'>TE AMO ANGELICA</p>
        <a class="underline! font-medium hover:no-underline" href="https://open.spotify.com/playlist/6FyxWfDINqiV0fypZ597Hr?si=WM4cma72TKqXTasadXDJnw&utm_source=whatsapp&pi=eBQf2TZTR8GP8" target="_blank">Un ultimo regalo 🎁</a>
        <button 
          id="btn-return-top"
          class="px-8 py-3 rounded-full border border-amber-400/40 bg-zinc-900/80 hover:bg-zinc-800 text-base font-semibold text-zinc-100 transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] hover:scale-[1.03] active:scale-[0.98] cursor-pointer shadow-lg mt-6"
        >
          Volver al comenzar
        </button>
      </div>
    </section>
  </main>
</Layout>

<script>
  import { ScrollWorldEngine } from '../utils/ScrollWorldEngine';
  import { AudioController } from '../utils/AudioController';
  import { AutoScrollController } from '../utils/AutoScrollController';
  import { AssetPreloadManager, type PreloadProgress } from '../utils/AssetPreloadManager';
  import { PerfMonitor } from '../utils/PerfMonitor';
  import { STORY_SECTIONS, INTRO_MEDIA } from '../config/story';
  import confetti from 'canvas-confetti';

  const audio = AudioController.getInstance();
  const autoscroll = AutoScrollController.getInstance();
  const preloadManager = AssetPreloadManager.getInstance();
  const perfMonitor = PerfMonitor.getInstance();
  const isMobile = preloadManager.isMobile();

  const videoLoop = document.getElementById('video-initial-loop') as HTMLVideoElement | null;
  const videoIntroStart = document.getElementById('video-intro-start') as HTMLVideoElement | null;
  const worldClipsContainer = document.getElementById('sw-world-clips') as HTMLElement | null;
  const heroOverlay = document.getElementById('intro-hero-overlay') as HTMLElement | null;
  const startBtn = document.getElementById('btn-start-journey') as HTMLButtonElement | null;
  const returnTopBtn = document.getElementById('btn-return-top') as HTMLButtonElement | null;
  const storyTrack = document.getElementById('scroll-story-track') as HTMLElement | null;
  const epilogue = document.getElementById('epilogue-section') as HTMLElement | null;
  const epilogueCard = document.getElementById('epilogue-card') as HTMLElement | null;
  const confettiCanvas = document.getElementById('epilogue-confetti-canvas') as HTMLCanvasElement | null;
  const cinemaBottomOverlay = document.getElementById('cinema-bottom-overlay') as HTMLElement | null;

  // Elementos de la pantalla de carga inicial
  const loadingScreen = document.getElementById('loading-screen');
  const loadingBar = document.getElementById('loading-progress-bar');
  const loadingNum = document.getElementById('loading-progress-number');
  const loadingText = document.getElementById('loading-status-text');

  let isIntroTransitionActive = false;
  let worldEngine: ScrollWorldEngine | null = null;
  let currentActiveWorldIndex = 0;
  let unlockedWorldIndex = 0;
  let hasPausedForWorld5Reading = false;
  if (typeof window !== 'undefined') {
    (window as any).__setUnlockedWorldIndex = (idx: number) => {
      unlockedWorldIndex = idx;
    };
  }

  // Precarga inteligente secuencial del mundo siguiente con progreso en el botón
  function triggerPreloadForWorld(targetWorldIdx: number) {
    if (targetWorldIdx >= STORY_SECTIONS.length) return;
    const targetSection = STORY_SECTIONS[targetWorldIdx];
    if (!targetSection) return;

    const targetClip = (isMobile && targetSection.clipMobile) ? targetSection.clipMobile : (targetSection.clips[0] || '');
    const targetAudio = targetSection.audioTrack || '';

    const prevBtn = document.getElementById(`btn-next-world-${targetWorldIdx - 1}`) as HTMLElement | null;
    const fillEl = prevBtn?.querySelector('.btn-progress-fill') as HTMLElement | null;
    const labelText = prevBtn?.querySelector('.btn-label-text') as HTMLElement | null;

    const onProgress = (p: PreloadProgress) => {
      if (fillEl) fillEl.style.width = `${p.percent}%`;
      if (labelText) {
        if (p.percent < 100) {
          labelText.textContent = `Preparando Mundo ${targetWorldIdx + 1} (${p.percent}%)`;
          if (prevBtn) {
            prevBtn.setAttribute('data-ready', 'false');
            prevBtn.style.cursor = 'wait';
          }
        } else {
          labelText.textContent = 'Siguiente Mundo';
          if (prevBtn) {
            prevBtn.setAttribute('data-ready', 'true');
            prevBtn.style.cursor = 'pointer';
          }
        }
      }
    };

    const cached = preloadManager.getCachedBlobUrl(targetClip);
    if (cached) {
      onProgress({ loaded: 100, total: 100, percent: 100 });
      return;
    }

    if (prevBtn) {
      prevBtn.setAttribute('data-ready', 'false');
      prevBtn.style.cursor = 'wait';
    }

    preloadManager.preload(targetClip, onProgress).then((blobUrl) => {
      worldEngine?.setClipBlob(targetWorldIdx, blobUrl);
      onProgress({ loaded: 100, total: 100, percent: 100 });
    });

    if (targetAudio) {
      preloadManager.preload(targetAudio);
    }
  }

  // 1. Bloquear el scroll inicialmente para que solo se vea el video loop del libro
  document.body.style.overflow = 'hidden';
  window.scrollTo(0, 0);

  // Registrar videos con el controlador de audio para sincronización
  if (videoLoop) {
    audio.registerVideo(videoLoop);
    perfMonitor.trackActiveVideo(videoLoop);
  }
  if (videoIntroStart) {
    audio.registerVideo(videoIntroStart);
  }

  // Inicializar carga de recursos esenciales (Loop + Intro + Mundo 1 + Audio 1)
  const initialLoopUrl = isMobile ? INTRO_MEDIA.initialLoopMobile : INTRO_MEDIA.initialLoopDesktop;
  const introStartUrl = isMobile ? INTRO_MEDIA.introStartMobile : INTRO_MEDIA.introStartDesktop;
  const world1Section = STORY_SECTIONS[0];
  const world1ClipUrl = (isMobile && world1Section?.clipMobile) ? world1Section.clipMobile : (world1Section?.clips[0] || '');
  const world1AudioUrl = world1Section?.audioTrack || '';

  const initialAssets = [initialLoopUrl, introStartUrl, world1ClipUrl, world1AudioUrl].filter(Boolean);

  preloadManager.preloadGroup(initialAssets, (percent) => {
    if (loadingBar) loadingBar.style.width = `${percent}%`;
    if (loadingNum) loadingNum.textContent = `${percent}%`;
    if (loadingText && percent >= 85) {
      loadingText.textContent = 'Abriendo el libro de memorias...';
    }
  }).then(() => {
    // Al completar la precarga inicial (100%), asignar los Blobs a los videos correspondientes
    const loopBlob = preloadManager.getCachedBlobUrl(initialLoopUrl);
    if (videoLoop) {
      videoLoop.src = loopBlob || initialLoopUrl;
    }
    const introBlob = preloadManager.getCachedBlobUrl(introStartUrl);
    if (videoIntroStart) {
      videoIntroStart.src = introBlob || introStartUrl;
    }

    // Iniciar reproducción del loop
    if (videoLoop) {
      videoLoop.play().catch(() => {
        videoLoop.muted = true;
        videoLoop.play().catch(() => {});
      });
    }

    // Desvanecer Loading Screen
    if (loadingScreen) {
      loadingScreen.style.opacity = '0';
      setTimeout(() => {
        loadingScreen.style.display = 'none';
      }, 1000);
    }
  });

  // Desmutear videoLoop en el primer toque/clic si el navegador exigía interacción previa
  const unmuteOnFirstGesture = () => {
    audio.unlock();
    if (videoLoop && !audio.getIsMuted()) {
      videoLoop.muted = false;
    }
    window.removeEventListener('click', unmuteOnFirstGesture);
    window.removeEventListener('touchstart', unmuteOnFirstGesture);
  };
  window.addEventListener('click', unmuteOnFirstGesture, { once: true, passive: true });
  window.addEventListener('touchstart', unmuteOnFirstGesture, { once: true, passive: true });

  // Distribución dinámica de tramos para cada mundo a partir del porcentaje `scroll` configurado en STORY_SECTIONS
  const totalScrollPercentage = STORY_SECTIONS.reduce((sum, sec) => sum + (sec.scroll ?? 20), 0);
  let accumulatedProgress = 0;
  const worldSpans = STORY_SECTIONS.map((sec, idx) => {
    const rawVal = sec.scroll ?? 20;
    const spanDuration = totalScrollPercentage > 0 ? rawVal / totalScrollPercentage : 1 / STORY_SECTIONS.length;
    const start = accumulatedProgress;
    const end = idx === STORY_SECTIONS.length - 1 ? 1.0 : accumulatedProgress + spanDuration;
    accumulatedProgress = end;
    return {
      worldIndex: idx,
      start,
      end,
    };
  });

  function getMaxStoryScroll(): number {
    if (!storyTrack) return 1;
    return Math.max(1, storyTrack.getBoundingClientRect().height - window.innerHeight);
  }

  // Punto de parada contemplativa para cada mundo (al 94% del tramo, dentro del mundo actual)
  function getWorldStopProgress(worldIdx: number): number {
    const span = worldSpans[worldIdx];
    if (!span) return 1;
    const spanDuration = span.end - span.start;
    return span.start + spanDuration * 0.94;
  }

  // Actualizar el efecto typewriter en sincronía bidireccional continua con el scroll (adelante y atrás)
  function updateTypewriterProgress(worldIdx: number, worldProgress: number) {
    const target = document.getElementById(`typeit-quote-${worldIdx}`);
    if (!target) return;

    const fullQuote = target.getAttribute('data-quote') || STORY_SECTIONS[worldIdx]?.quote || '';
    const textSpan = target.querySelector('.ti-text') as HTMLElement | null;
    if (!textSpan) return;

    // Rango de tipeo dentro del mundo: desde el 4% hasta el umbral
    // En el último mundo concluye al 16% del tramo para que el texto completo quede disponible durante más del 84% restante del scroll
    const endRatio = worldIdx === STORY_SECTIONS.length - 1 ? 0.16 : 0.75;
    const ratio = Math.min(1, Math.max(0, (worldProgress - 0.04) / (endRatio - 0.04)));
    const targetLength = Math.round(ratio * fullQuote.length);

    // Escribir hacia adelante o retrasar/borrar hacia atrás según la posición exacta del scroll
    const currentLength = textSpan.textContent?.length || 0;
    if (currentLength !== targetLength) {
      textSpan.textContent = fullQuote.slice(0, targetLength);

      // Desplazar automáticamente hacia abajo a medida que se escribe solo si excede la altura visible
      const scrollBox = target.closest('.text-reveal-scroll') as HTMLElement | null;
      if (scrollBox) {
        const maxScroll = scrollBox.scrollHeight - scrollBox.clientHeight;
        if (maxScroll > 10) {
          scrollBox.scrollTop = maxScroll;
        } else {
          scrollBox.scrollTop = 0;
        }

        // Solo desvanecer arriba si tiene scroll activo y se ha desplazado hacia abajo
        if (maxScroll > 10 && scrollBox.scrollTop > 14) {
          scrollBox.classList.add('is-scrolled');
        } else {
          scrollBox.classList.remove('is-scrolled');
        }
      }
    }
  }

  function resetAllTypewriters() {
    STORY_SECTIONS.forEach((_, idx) => {
      const target = document.getElementById(`typeit-quote-${idx}`);
      const textSpan = target?.querySelector('.ti-text') as HTMLElement | null;
      if (textSpan) textSpan.textContent = '';
      const scrollBox = target?.closest('.text-reveal-scroll') as HTMLElement | null;
      if (scrollBox) {
        scrollBox.scrollTop = 0;
        scrollBox.classList.remove('is-scrolled');
      }
    });
  }

  // Actualizar qué mundo se muestra en la parte baja de la pantalla
  function updateActiveWorld(worldIdx: number, playAudio: boolean = true) {
    currentActiveWorldIndex = worldIdx;

    // Cambiar audio ambiental suavemente
    const targetSection = STORY_SECTIONS[worldIdx];
    if (playAudio && targetSection && targetSection.audioTrack) {
      audio.playTrack(targetSection.audioTrack, 1600);
    }

    // Actualizar paneles de texto en la parte baja de la pantalla
    const panels = document.querySelectorAll('.narrative-world-panel');
    panels.forEach((panel) => {
      const idx = Number(panel.getAttribute('data-world-index'));
      const el = panel as HTMLElement;
      const targetQuote = document.getElementById(`typeit-quote-${idx}`);
      const textSpan = targetQuote?.querySelector('.ti-text') as HTMLElement | null;
      const quoteText = targetQuote?.getAttribute('data-quote') || STORY_SECTIONS[idx]?.quote || '';

      if (idx === worldIdx) {
        el.style.opacity = '1';
        el.style.transform = 'translateY(0)';
        el.style.pointerEvents = 'auto';
        const scrollBox = targetQuote?.closest('.text-reveal-scroll') as HTMLElement | null;
        if (scrollBox && (!textSpan?.textContent || textSpan.textContent.length === 0)) {
          scrollBox.scrollTop = 0;
          scrollBox.classList.remove('is-scrolled');
        }
      } else if (idx < worldIdx) {
        el.style.opacity = '0';
        el.style.transform = 'translateY(-16px)';
        el.style.pointerEvents = 'none';
        // Si el usuario ya pasó este mundo hacia adelante, mantener el texto completo
        if (textSpan && textSpan.textContent?.length !== quoteText.length) {
          textSpan.textContent = quoteText;
        }
      } else {
        el.style.opacity = '0';
        el.style.transform = 'translateY(16px)';
        el.style.pointerEvents = 'none';
        // Si es un mundo futuro que aún no se alcanza, mantener vacío
        if (textSpan) textSpan.textContent = '';
      }
    });
  }

  // Manejar el progreso continuo del scroll: sincronización bidireccional del texto y overlay
  function handleProgress(rawProgress: number, activeWorldIdx: number, worldProgress: number) {
    if (cinemaBottomOverlay && isIntroTransitionActive) {
      const maxScroll = getMaxStoryScroll();
      // El texto permanece visible durante todo el recorrido del último mundo.
      // Solo comienza a desvanecerse suavemente al aproximarse al epílogo final cuando sobrepasa la pista
      if (window.scrollY >= maxScroll - 15) {
        cinemaBottomOverlay.style.opacity = '0';
        cinemaBottomOverlay.style.pointerEvents = 'none';
      } else {
        cinemaBottomOverlay.style.opacity = '1';
        cinemaBottomOverlay.style.pointerEvents = 'auto';
      }
    }

    // Sincronizar tipeo y borrado de caracteres según el scroll exacto (adelante y atrás)
    if (isIntroTransitionActive) {
      updateTypewriterProgress(activeWorldIdx, worldProgress);

      // Si auto-scroll está activo y el último mundo termina de tipear su mensaje, pausar automáticamente para dar tiempo de lectura
      if (activeWorldIdx === STORY_SECTIONS.length - 1 && worldProgress >= 0.18 && !hasPausedForWorld5Reading) {
        hasPausedForWorld5Reading = true;
        if (autoscroll.getIsRunning()) {
          autoscroll.pauseAndStartCountdown(18000); // 18 segundos de pausa serena de lectura
        }
      }

      // Gestión de la barrera de detención por mundo y revelado del CTA "Siguiente Mundo" (mundos 0 a 3)
      if (unlockedWorldIndex < STORY_SECTIONS.length - 1) {
        const stopProgress = getWorldStopProgress(unlockedWorldIndex);
        const maxScroll = getMaxStoryScroll();
        const maxAllowedScrollY = Math.round(stopProgress * maxScroll);
        const currentBtn = document.getElementById(`btn-next-world-${unlockedWorldIndex}`) as HTMLElement | null;

        // Mostrar botón cuando el mundo actual esté concluyendo su narrativa (>= 75%)
        if (activeWorldIdx === unlockedWorldIndex && worldProgress >= 0.75) {
          if (currentBtn) {
            currentBtn.style.opacity = '1';
            currentBtn.style.pointerEvents = 'auto';
            currentBtn.style.transform = 'translateY(0)';
          }
        } else if (activeWorldIdx === unlockedWorldIndex && worldProgress < 0.69) {
          if (currentBtn) {
            currentBtn.style.opacity = '0';
            currentBtn.style.pointerEvents = 'none';
            currentBtn.style.transform = 'translateY(12px)';
          }
        }

        // Si el usuario retrocede con el scroll antes del punto de parada, liberar la pausa del CTA
        if (window.scrollY < maxAllowedScrollY - 25) {
          autoscroll.clearWorldCTAPause();
        }

        // Si el desplazamiento alcanza el punto de parada del mundo actual, detener auto-scroll y asegurar tope
        if (window.scrollY >= maxAllowedScrollY) {
          autoscroll.pauseForWorldCTA();
          if (window.scrollY > maxAllowedScrollY) {
            window.scrollTo({ top: maxAllowedScrollY, behavior: 'instant' });
          }
        }
      }
    }
  }

  // Inicializar clips para el scrub engine (pre-carga en memoria Blobs)
  if (worldClipsContainer && storyTrack) {
    const clipItems: Array<{ id: string; url: string; urlMobile?: string; linger?: number; start?: number; end?: number }> = [];

    STORY_SECTIONS.forEach((sec, sIdx) => {
      const span = worldSpans.find((w) => w.worldIndex === sIdx) || {
        start: sIdx / STORY_SECTIONS.length,
        end: (sIdx + 1) / STORY_SECTIONS.length,
      };
      const spanDuration = span.end - span.start;
      const clips = sec.clips || [];

      if (clips.length > 0) {
        // En el último mundo, el video culmina temprano (al 22% del tramo) para que el fotograma final quede sereno de fondo mientras se lee todo el texto
        const clipFactor = sIdx === STORY_SECTIONS.length - 1 ? 0.22 : 0.90;
        const clipsSpanDuration = spanDuration * clipFactor;
        const clipSlice = clipsSpanDuration / clips.length;
        clips.forEach((clipUrl, cIdx) => {
          clipItems.push({
            id: `world-${sec.worldNumber}-clip-${cIdx}`,
            url: clipUrl,
            urlMobile: sec.clipMobile,
            linger: sec.linger ?? 0.45,
            start: span.start + cIdx * clipSlice,
            end: span.start + (cIdx + 1) * clipSlice,
          });
        });
      }
    });

    worldEngine = new ScrollWorldEngine({
      container: worldClipsContainer,
      trackElement: storyTrack,
      clips: clipItems,
      worldSpans: worldSpans,
      onWorldChange: (worldIdx) => {
        updateActiveWorld(worldIdx);
      },
      onProgress: (rawProgress, _clipIdx, activeWorldIdx, worldProgress) => {
        handleProgress(rawProgress, activeWorldIdx, worldProgress);
      }
    });
  }

  // Interacción del Hero: Comenzar -> on_intro_start.mp4 -> Desbloquea Scroll-World
  if (startBtn && videoIntroStart && videoLoop && worldClipsContainer && storyTrack) {
    startBtn.addEventListener('click', async () => {
      if (isIntroTransitionActive) return;
      isIntroTransitionActive = true;

      // Desbloquear audio globalmente
      audio.unlock();

      // Asegurar que on_intro_start esté desmuteado según el estado de audio
      videoIntroStart.muted = audio.getIsMuted();

      // Ocultar botón del hero
      if (heroOverlay) {
        heroOverlay.style.opacity = '0';
        heroOverlay.style.pointerEvents = 'none';
        setTimeout(() => { heroOverlay.style.display = 'none'; }, 700);
      }

      // Traer al frente y reproducir el video de transición on_intro_start
      videoIntroStart.style.zIndex = '15';
      videoIntroStart.style.opacity = '1';
      videoIntroStart.volume = 1;
      videoIntroStart.currentTime = 0;

      try {
        await videoIntroStart.play();
      } catch (_e) {
        // En caso extremo de bloqueo
        videoIntroStart.muted = true;
        await videoIntroStart.play().catch(() => {});
      }

      // Desvanecer video loop inicial tras arrancar
      setTimeout(() => {
        videoLoop.style.opacity = '0';
        videoLoop.pause();
      }, 400);

      // Fade out suave del audio del video introductorio en sus ultimos segundos
      let isAudioFadingOut = false;
      let hasEndedTriggered = false;
      const audioFadeDurationSec = 1.2; // 1200ms de fade out antes de terminar

      const handleIntroEnd = () => {
        if (hasEndedTriggered) return;
        hasEndedTriggered = true;

        videoIntroStart.removeEventListener('timeupdate', onTimeUpdate);
        videoIntroStart.pause();
        // IMPORTANTE: NO reiniciar currentTime = 0 aquí para que el video permanezca
        // pausado en su fotograma final mientras se realiza el crossfade con los clips del mundo.

        // 1. Mostrar los clips del mundo y activar primer mundo (inicia su audio)
        worldClipsContainer.style.zIndex = '20';
        worldClipsContainer.style.opacity = '1';
        updateActiveWorld(0);

        // Iniciar precarga en segundo plano de Mundo 2 mientras el usuario lee Mundo 1
        triggerPreloadForWorld(1);

        // 2. Desvanecer el video de intro suavemente con su transición CSS de 1000ms
        videoIntroStart.style.opacity = '0';

        // 3. Habilitar la pista de scroll, el overlay narrativo inferior y el epílogo
        storyTrack.classList.remove('hidden');
        if (cinemaBottomOverlay) {
          cinemaBottomOverlay.style.opacity = '1';
        }
        if (epilogue) epilogue.classList.remove('hidden');

        // Desbloquear el scroll del documento
        document.body.style.overflow = '';
        document.documentElement.style.overflow = '';

        // Actualizar dimensiones en el motor de scroll
        worldEngine?.update();

        // Tras concluir el fundido visual (1000ms), enviar intro al fondo y pausar
        setTimeout(() => {
          videoIntroStart.style.zIndex = '0';
          videoIntroStart.pause();
          videoIntroStart.volume = 1;
        }, 1000);

        // Iniciar el auto-scroll poético con un respiro natural tras abrirse el mundo
        setTimeout(() => {
          worldEngine?.update();
          autoscroll.startJourney();
        }, 1200);
      };

      const onTimeUpdate = () => {
        if (!videoIntroStart.duration || hasEndedTriggered) return;
        const timeLeft = videoIntroStart.duration - videoIntroStart.currentTime;

        // Asegurar la captura del final si el navegador llega al último tramo
        if (timeLeft <= 0.04) {
          handleIntroEnd();
          return;
        }

        if (timeLeft <= audioFadeDurationSec && timeLeft > 0 && !isAudioFadingOut) {
          isAudioFadingOut = true;
          // Iniciar fade out progresivo del volumen
          const startVol = videoIntroStart.volume;
          const fadeStartTime = performance.now();
          const fadeMs = timeLeft * 1000;

          const stepFade = (now: number) => {
            const elapsed = now - fadeStartTime;
            const progress = Math.min(1, elapsed / fadeMs);
            videoIntroStart.volume = Math.max(0, startVol * (1 - progress));
            if (progress < 1 && !videoIntroStart.paused) {
              requestAnimationFrame(stepFade);
            }
          };
          requestAnimationFrame(stepFade);
        }
      };
      videoIntroStart.addEventListener('timeupdate', onTimeUpdate);

      // Cuando termine el video de transición, transición suave hacia los mundos
      videoIntroStart.onended = handleIntroEnd;
    });
  }

  // ============================================================================
  // Fuegos Artificiales / Confetti Detrás del Card Final (Epílogo)
  // ============================================================================
  let confettiInstance: confetti.CreateTypes | null = null;
  if (confettiCanvas) {
    confettiInstance = confetti.create(confettiCanvas, {
      resize: true,
      useWorker: false,
    });
  }

  let fireworksTimer: number | null = null;
  let isFireworksRunning = false;

  function getEpilogueCardBounds() {
    if (!epilogueCard) {
      return { minX: 0.35, maxX: 0.65, minY: 0.35, maxY: 0.65 };
    }
    const rect = epilogueCard.getBoundingClientRect();
    const vw = Math.max(1, window.innerWidth);
    const vh = Math.max(1, window.innerHeight);

    // Coordenadas calculadas detrás del cuerpo del card
    const minX = Math.max(0.05, Math.min(0.95, (rect.left + rect.width * 0.15) / vw));
    const maxX = Math.max(0.05, Math.min(0.95, (rect.right - rect.width * 0.15) / vw));
    const minY = Math.max(0.05, Math.min(0.95, (rect.top + rect.height * 0.2) / vh));
    const maxY = Math.max(0.05, Math.min(0.95, (rect.bottom - rect.height * 0.2) / vh));

    return { minX, maxX, minY, maxY };
  }

  function launchFireworkBurst() {
    if (!confettiInstance) return;

    const bounds = getEpilogueCardBounds();
    const originX = bounds.minX + Math.random() * (bounds.maxX - bounds.minX);
    const originY = bounds.minY + Math.random() * (bounds.maxY - bounds.minY);

    const palettes = [
      ['#d4af37', '#f59e0b', '#fbbf24', '#fef08a', '#ffffff'], // Oro estelar
      ['#f43f5e', '#ec4899', '#fda4af', '#f472b6', '#ffffff'], // Rosa romance
      ['#38bdf8', '#818cf8', '#60a5fa', '#c084fc', '#ffffff'], // Azul cósmico
      ['#eab308', '#ec4899', '#a855f7', '#38bdf8', '#ffffff'], // Mágico multicolor
      ['#34d399', '#6ee7b7', '#10b981', '#fef08a', '#ffffff'], // Esmeralda / aurora
    ];
    const colors = palettes[Math.floor(Math.random() * palettes.length)];

    const particleCount = isMobile
      ? 28 + Math.floor(Math.random() * 20)
      : 45 + Math.floor(Math.random() * 30);

    confettiInstance({
      particleCount,
      spread: 360,
      startVelocity: isMobile ? 32 + Math.random() * 16 : 42 + Math.random() * 22,
      decay: 0.91,
      gravity: 0.65,
      ticks: 180 + Math.floor(Math.random() * 60),
      scalar: 0.85 + Math.random() * 0.45,
      origin: { x: originX, y: originY },
      colors,
      shapes: ['circle', 'square', 'star'],
      disableForReducedMotion: true,
    });
  }

  function startFireworks() {
    if (isFireworksRunning || !confettiInstance || !confettiCanvas) return;
    isFireworksRunning = true;
    confettiCanvas.style.opacity = '1';

    // Ráfagas iniciales detonando detrás del card
    launchFireworkBurst();
    setTimeout(() => { if (isFireworksRunning) launchFireworkBurst(); }, 120);
    setTimeout(() => { if (isFireworksRunning) launchFireworkBurst(); }, 250);

    // Explosiones continuas de fuegos artificiales mientras permanezca al final
    fireworksTimer = window.setInterval(() => {
      if (!isFireworksRunning) return;
      launchFireworkBurst();
      if (Math.random() > 0.4) {
        setTimeout(() => {
          if (isFireworksRunning) launchFireworkBurst();
        }, 130);
      }
    }, 450);
  }

  function stopFireworks() {
    if (!isFireworksRunning && fireworksTimer === null) return;
    isFireworksRunning = false;

    if (fireworksTimer !== null) {
      clearInterval(fireworksTimer);
      fireworksTimer = null;
    }

    if (confettiInstance) {
      confettiInstance.reset();
    }

    if (confettiCanvas) {
      confettiCanvas.style.opacity = '0';
      const ctx = confettiCanvas.getContext('2d');
      ctx?.clearRect(0, 0, confettiCanvas.width, confettiCanvas.height);
    }
  }

  function checkEpilogueScroll() {
    if (!isIntroTransitionActive) {
      if (isFireworksRunning) stopFireworks();
      return;
    }

    const scrollY = window.scrollY;
    const maxScroll = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
    const distanceToBottom = maxScroll - scrollY;

    // Cuando se llega al final de la página (a menos de 100px del tope inferior)
    if (distanceToBottom <= 100) {
      if (!isFireworksRunning) {
        startFireworks();
      }
    } else if (distanceToBottom > 200) {
      // Al hacer scroll hacia arriba, desaparece por completo
      if (isFireworksRunning) {
        stopFireworks();
      }
    }
  }

  // Listener de scroll para el motor y fuegos artificiales del epílogo
  window.addEventListener('scroll', () => {
    worldEngine?.update();
    checkEpilogueScroll();
  }, { passive: true });

  window.addEventListener('resize', () => {
    checkEpilogueScroll();
  }, { passive: true });

  // Frenar scroll manual (rueda / touchpad) al punto de parada del mundo actual antes de hacer clic en el CTA
  window.addEventListener('wheel', (e) => {
    if (!isIntroTransitionActive) return;
    if (unlockedWorldIndex >= STORY_SECTIONS.length - 1) return;
    const maxScroll = getMaxStoryScroll();
    const stopProgress = getWorldStopProgress(unlockedWorldIndex);
    const maxAllowedScrollY = Math.round(stopProgress * maxScroll);

    if (window.scrollY >= maxAllowedScrollY - 2 && e.deltaY > 0) {
      // Si el evento ocurre sobre un panel de texto que aún puede scrollear hacia abajo, permitir su scroll interno
      const targetEl = e.target as HTMLElement | null;
      const scrollBox = targetEl?.closest('.text-reveal-scroll') as HTMLElement | null;
      if (scrollBox && scrollBox.scrollTop < scrollBox.scrollHeight - scrollBox.clientHeight - 2) {
        return;
      }
      e.preventDefault();
      window.scrollTo({ top: maxAllowedScrollY, behavior: 'instant' });
      autoscroll.pauseForWorldCTA();
    }
  }, { passive: false });

  // Frenar desplazamiento táctil en móviles al punto de parada del mundo actual
  let touchStartY = 0;
  window.addEventListener('touchstart', (e) => {
    if (e.touches[0]) {
      touchStartY = e.touches[0].clientY;
    }
  }, { passive: true });

  window.addEventListener('touchmove', (e) => {
    if (!isIntroTransitionActive) return;
    if (unlockedWorldIndex >= STORY_SECTIONS.length - 1) return;
    const maxScroll = getMaxStoryScroll();
    const stopProgress = getWorldStopProgress(unlockedWorldIndex);
    const maxAllowedScrollY = Math.round(stopProgress * maxScroll);
    const currentY = e.touches[0]?.clientY || 0;
    const isScrollingDown = currentY < touchStartY;

    if (window.scrollY >= maxAllowedScrollY - 2 && isScrollingDown) {
      // Si el desplazamiento táctil ocurre dentro del contenedor de texto y puede scrollear hacia abajo, permitirlo
      const targetEl = e.target as HTMLElement | null;
      const scrollBox = targetEl?.closest('.text-reveal-scroll') as HTMLElement | null;
      if (scrollBox && scrollBox.scrollTop < scrollBox.scrollHeight - scrollBox.clientHeight - 2) {
        return;
      }
      e.preventDefault();
      window.scrollTo({ top: maxAllowedScrollY, behavior: 'instant' });
      autoscroll.pauseForWorldCTA();
    }
  }, { passive: false });

  // Manejador del clic en los botones "Siguiente Mundo"
  document.querySelectorAll('.btn-next-world').forEach((btnEl) => {
    btnEl.addEventListener('click', (e) => {
      e.stopPropagation();

      // Si el clip aún no ha concluido su descarga en memoria, impedir avance prematuro
      if (btnEl.getAttribute('data-ready') === 'false') {
        return;
      }

      const idx = Number(btnEl.getAttribute('data-world-index'));
      const targetWorldIdx = idx + 1;

      // Ocultar botón actual con animación suave
      const btn = btnEl as HTMLElement;
      btn.style.opacity = '0';
      btn.style.pointerEvents = 'none';
      btn.style.transform = 'translateY(12px)';

      // Desbloquear el siguiente mundo
      unlockedWorldIndex = targetWorldIdx;

      // Iniciar de inmediato la precarga en background del mundo subsiguiente (Mundo 3, 4, etc.)
      triggerPreloadForWorld(targetWorldIdx + 1);

      // Transición fluida de scroll hacia el umbral del siguiente mundo
      const nextSpan = worldSpans[targetWorldIdx];
      if (nextSpan) {
        const maxScroll = getMaxStoryScroll();
        const targetScrollY = Math.round((nextSpan.start + 0.005) * maxScroll);
        window.scrollTo({
          top: targetScrollY,
          behavior: 'smooth'
        });

        // Reanudar el auto-scroll suavemente tras iniciar el desplazamiento al nuevo mundo
        setTimeout(() => {
          autoscroll.resumeAfterWorldCTA();
        }, 850);
      }
    });
  });

  // Botón volver al inicio: resetear completamente la experiencia
  if (returnTopBtn) {
    returnTopBtn.addEventListener('click', () => {
      // 1. Llevar scroll de inmediato al tope
      window.scrollTo({ top: 0, behavior: 'instant' });

      // 2. Bloquear nuevamente el scroll
      document.body.style.overflow = 'hidden';
      document.documentElement.style.overflow = 'hidden';

      // 3. Ocultar la pista de historias, el overlay narrativo inferior y el epílogo
      if (storyTrack) storyTrack.classList.add('hidden');
      if (cinemaBottomOverlay) cinemaBottomOverlay.style.opacity = '0';
      if (epilogue) epilogue.classList.add('hidden');

      // Detener fuegos artificiales de inmediato
      stopFireworks();

      // Detener y resetear auto-scroll
      autoscroll.stop();

      // 4. Ocultar clips del mundo
      if (worldClipsContainer) {
        worldClipsContainer.style.opacity = '0';
        worldClipsContainer.style.zIndex = '0';
      }

      // 5. Restablecer y pausar video on_intro_start
      if (videoIntroStart) {
        videoIntroStart.pause();
        videoIntroStart.currentTime = 0;
        videoIntroStart.style.opacity = '0';
        videoIntroStart.style.zIndex = '0';
      }

      // 6. Volver a mostrar y reproducir el loop inicial del libro
      if (videoLoop) {
        videoLoop.currentTime = 0;
        videoLoop.style.opacity = '1';
        videoLoop.style.zIndex = '10';
        videoLoop.play().catch(() => {});
      }

      // 7. Mostrar nuevamente el botón del hero
      if (heroOverlay) {
        heroOverlay.style.display = 'flex';
        heroOverlay.style.pointerEvents = 'auto';
        requestAnimationFrame(() => {
          heroOverlay.style.opacity = '1';
        });
      }

      // 8. Resetear audio de los mundos, flags de estado, typewriter, botones CTA y motor
      audio.stopAll();
      isIntroTransitionActive = false;
      unlockedWorldIndex = 0;
      hasPausedForWorld5Reading = false;
      document.querySelectorAll('.btn-next-world').forEach((b) => {
        const el = b as HTMLElement;
        el.style.opacity = '0';
        el.style.pointerEvents = 'none';
        el.style.transform = 'translateY(12px)';
      });
      worldEngine?.reset();
      resetAllTypewriters();
      updateActiveWorld(0, false);
    });
  }
</script>
