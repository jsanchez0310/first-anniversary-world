---
import '@fontsource/princess-sofia';
import '@fontsource/henny-penny';
import '@fontsource/geist-mono';
import '../styles/global.css';
import OrientationLock from '../components/OrientationLock.astro';

interface Props {
	title?: string;
}

const { title = 'Primer Aniversario' } = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth bg-black text-zinc-100 antialiased selection:bg-amber-400/20 selection:text-amber-200">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>


		<!-- Librería TypeIt para efecto typewriter auténtico -->
		<script is:inline src="/vendor/typeit.umd.js"></script>
	</head>
	<body class="bg-black text-zinc-100 overflow-x-hidden">
		<!-- Bloqueo cinematográfico de orientación en móviles -->
		<OrientationLock />
		<!-- Capa global del filtro de grano fino de cine (Film Grain animado) -->
		<div class="film-grain" aria-hidden="true"></div>
		<!-- Viñeta cinematográfica de bordes oscuros (Lens Vignette) -->
		<div class="film-vignette" aria-hidden="true"></div>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--font-title: 'Princess Sofia', cursive, sans-serif;
		--font-body: 'Henny Penny', cursive, sans-serif;
		--font-mono: 'Geist Mono', monospace;
	}

	html,
	body {
		margin: 0;
		padding: 0;
		width: 100%;
		background-color: #000000;
		color: #f4f4f5;
		font-family: var(--font-body);
	}

	/* Títulos con Princess Sofia */
	h1, h2, h3, h4, h5, h6, .font-title {
		font-family: var(--font-title);
	}

	/* Párrafos, citas y textos de lectura con Henny Penny */
	p, blockquote, .font-body {
		font-family: var(--font-body);
	}

	/* Scrollbar discreto */
	::-webkit-scrollbar {
		width: 6px;
	}
	::-webkit-scrollbar-track {
		background: #09090b;
	}
	::-webkit-scrollbar-thumb {
		background: #27272a;
		border-radius: 9999px;
	}
	::-webkit-scrollbar-thumb:hover {
		background: #3f3f46;
	}
</style>
