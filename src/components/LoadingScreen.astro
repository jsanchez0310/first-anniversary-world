---
// LoadingScreen.astro
// Pantalla de carga inicial cinematográfica con barra de progreso real (0% -> 100%)
---

<div
  id="loading-screen"
  class="fixed inset-0 z-50 flex flex-col items-center justify-center bg-[#000000] text-zinc-100 transition-opacity duration-1000 ease-in-out pointer-events-auto"
>
  <!-- Polvo estelar sutil de fondo -->
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-amber-950/20 via-black to-black pointer-events-none"></div>

  <div class="relative z-10 flex flex-col items-center text-center px-6 max-w-md">
    <!-- Título poético -->
    <h1 class="font-title text-3xl sm:text-4xl text-amber-200/90 mb-2 drop-shadow-[0_2px_12px_rgba(212,175,55,0.4)]">
      Primer Aniversario
    </h1>
    <p id="loading-status-text" class="font-body text-sm text-zinc-400 mb-8 tracking-wide">
      Sintonizando las memorias...
    </p>

    <!-- Contenedor de la Barra de Progreso -->
    <div class="w-64 sm:w-80 h-2 rounded-full bg-zinc-900 border border-amber-500/30 overflow-hidden p-[1px] shadow-[0_0_15px_rgba(212,175,55,0.15)] mb-3">
      <div
        id="loading-progress-bar"
        class="h-full w-0 rounded-full bg-gradient-to-r from-amber-600 via-amber-400 to-amber-200 transition-all duration-200 ease-out shadow-[0_0_8px_#d4af37]"
      ></div>
    </div>

    <!-- Indicador de porcentaje numérico -->
    <div class="flex items-center gap-2">
      <span class="inline-block w-1.5 h-1.5 rounded-full bg-[#d4af37] animate-ping"></span>
      <span id="loading-progress-number" class="font-mono text-xs text-amber-200/80 tracking-widest">
        0%
      </span>
    </div>
  </div>
</div>
