---
// Indicador minimalista y silencioso de inicio/scroll sobre el video limpio
---

<div id="intro-hero-overlay" class="fixed inset-0 z-20 flex flex-col items-center justify-end pb-12 pointer-events-none transition-opacity duration-700 ease-[cubic-bezier(0.32,0.72,0,1)]">
  <!-- Boton o prompt minimalista para comenzar la inmersion auditiva o deslizar -->
  <div class="pointer-events-auto flex flex-col items-center gap-3">
    <button
      id="btn-start-journey"
      class="group flex items-center gap-2.5 px-6 py-2.5 rounded-full bg-black/40  hover:bg-black/70 border border-amber-400/40 text-amber-200/90 hover:text-white font-mono text-xs tracking-widest uppercase backdrop-blur-md transition-all duration-500 hover:scale-105 active:scale-95 cursor-pointer shadow-2xl"
    >
      <span class="w-1.5 h-1.5 rounded-full bg-[#d4af37] animate-ping"></span>
      <span>Comenzar</span>
      <svg class="w-3.5 h-3.5 transition-transform duration-500 ease-out group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
      </svg>
    </button>

  </div>
</div>
